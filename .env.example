# ELNARE — Beyond Distance
# Bu dosyayı `.env.local` olarak kopyala ve değerleri doldur. `.env.local` asla commit edilmez.
# Hiçbir değişken NEXT_PUBLIC_ ile başlamaz: tarayıcı Supabase ile doğrudan konuşmaz.

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
# GİZLİ. RLS'i atlar. Yalnızca sunucuda kullanılır.
SUPABASE_SERVICE_ROLE_KEY=

# En az 32 karakterlik rastgele bir değer:  openssl rand -base64 48
APP_SECRET=

# /setup ekranında bir kez sorulan anahtar:  openssl rand -base64 24
SETUP_SECRET=

# Sitenin yayındaki adresi (davet bağlantıları bununla üretilir). Yerelde boş bırakılabilir.
SITE_URL=

# Next.js anonim telemetrisini kapatır.
NEXT_TELEMETRY_DISABLED=1
