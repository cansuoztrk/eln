# ─────────────────────────────────────────────────────────────────────────────
# FırsatRadar — örnek ortam değişkenleri
# Bu dosyayı .env olarak kopyalayın. GERÇEK ANAHTARLARI ASLA DEPOYA EKLEMEYİN.
# ─────────────────────────────────────────────────────────────────────────────

# Veritabanı (PostgreSQL 14+; pg_trgm ve unaccent eklentileri gerekir)
DATABASE_URL="postgresql://firsat:firsat@localhost:5432/firsatradar?schema=public"
DATABASE_POOL_MAX=10

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_BRAND_NAME="FırsatRadar"
NEXT_PUBLIC_CONTACT_EMAIL="iletisim@example.com"
NEXT_PUBLIC_MARKET="tr"

# Güvenlik
# Oturum çerezi imzası ve anonim analitik özetleri için (en az 32 karakter rastgele değer):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""
ANALYTICS_SALT=""
# HTTP cron uç noktası (/api/cron/tick) için Bearer anahtarı (en az 16 karakter)
CRON_SECRET=""

# Test verisi görünürlüğü: üretimde varsayılan false, geliştirmede true
# SHOW_TEST_DATA=false

# Worker
WORKER_CONCURRENCY=2
WORKER_POLL_MS=3000
LOG_DEBUG=false

# E-posta (SMTP). Boş bırakılırsa e-postalar "SKIPPED" olur, site içi bildirimler çalışır.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="FırsatRadar <bildirim@example.com>"

# ── E-ticaret veri kaynakları ────────────────────────────────────────────────
# Amazon Türkiye — Creators API (Amazon Ortaklık Programı onayı gerekir)
AMAZON_CREATORS_CLIENT_ID=""
AMAZON_CREATORS_CLIENT_SECRET=""
AMAZON_PARTNER_TAG=""

# Trendyol / Hepsiburada — yalnızca resmî veri ortaklığı veya yetkili satış ortaklığı ağı
# üzerinden elde edilmiş ürün feed adresleri (scraping yapılmaz).
TRENDYOL_PARTNER_FEED_URL=""
HEPSIBURADA_PARTNER_FEED_URL=""

# Genel ürün feed'leri: yönetim panelinde "Ürün veri akışı" kaynağı eklerken verilen
# değişken adı (FEED_ ön ekiyle başlamalıdır), ör.:
# FEED_ORNEK_MAGAZA_URL="https://...feed.xml?token=..."

# ── Uçuş veri kaynakları ─────────────────────────────────────────────────────
# Travelpayouts (Aviasales Data API) — ücretsiz kayıt, profildeki API token
TRAVELPAYOUTS_TOKEN=""
# Satış ortaklığı işaretçisi (isteğe bağlı)
TRAVELPAYOUTS_MARKER=""
# Duffel — canlı arama (ücretli kullanım, önce test anahtarıyla deneyin)
DUFFEL_ACCESS_TOKEN=""
