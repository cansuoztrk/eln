# ELNARE — Beyond Distance
# Bu dosyayı `.env.local` olarak kopyala ve değerleri doldur. `.env.local` asla commit edilmez.
# Hiçbir değişken NEXT_PUBLIC_ ile başlamaz: tarayıcı Supabase ile doğrudan konuşmaz.

# Supabase → Project Settings → API Keys (adres: Project Settings → Data API ya da üstteki "Connect").
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# "Publishable key" (sb_publishable_… ile başlar). Eski projelerde adı "anon" anahtarıdır.
SUPABASE_ANON_KEY=
# "Secret key" (sb_secret_… ile başlar). Eski projelerde adı "service_role" anahtarıdır.
# GİZLİ. RLS'i atlar. Yalnızca sunucuda kullanılır; kimseyle paylaşma, hiçbir yere yapıştırma.
SUPABASE_SERVICE_ROLE_KEY=

# En az 32 karakterlik rastgele bir değer:  openssl rand -base64 48
APP_SECRET=

# /setup ekranında bir kez sorulan anahtar:  openssl rand -base64 24
SETUP_SECRET=

# Sitenin yayındaki adresi. Boş bırakılabilir: davet bağlantıları o an açık olan adresle üretilir.
# Yalnızca bağlantıların hep aynı (özel) alan adıyla üretilmesini istersen doldur.
SITE_URL=

# Next.js anonim telemetrisini kapatır.
NEXT_TELEMETRY_DISABLED=1
