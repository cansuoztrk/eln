{
  "name": "simit-tycoon",
  "private": true,
  "version": "1.0.0",
  "description": "Simit Tycoon: Idle Cat Café — Tekir Studios",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "simulate": "vitest run --config scripts/vitest.sim.ts",
    "cap:sync": "npm run build && cap sync",
    "cap:ios": "npm run build && cap sync ios && cap open ios",
    "cap:android": "npm run build && cap sync android && cap open android",
    "calibrate": "vitest run --config scripts/vitest.calibrate.ts"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.2.1",
    "@capacitor-community/in-app-review": "^8.0.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/baloo-2": "^5.3.0",
    "@revenuecat/purchases-capacitor": "^13.7.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "playwright-core": "^1.64.1",
    "typescript": "5.9",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
